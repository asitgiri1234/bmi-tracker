<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real Material 3 theme at runtime; this XML theme only
      styles the window before the first frame, so it stays deliberately minimal.
    -->
    <style name="Theme.BMITracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
